{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "gpt-4",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0
  },
  "codex_cli_provider_example": {
    "provider": "codex_cli",
    "model": "codex-cli",
    "languages": [
      "ru"
    ],
    "codex_command": "codex",
    "codex_timeout_sec": 180,
    "codex_extra_args": [
      "--skip-git-repo-check",
      "-c",
      "model_reasoning_effort=\"medium\""
    ],
    "codex_use_output_last_message": true,
    "codex_use_json": false
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "xxx@qq.com",
    "sender_name": "Horizon Brief Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "story_lists": ["top", "best"],
      "include_jobs": false
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "LWN.net (subscriber full-text)",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux (requires LWN_KEY env var)"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        }
      ],
      "users": [
        {
          "username": "iamthatis",
          "enabled": true,
          "sort": "new",
          "fetch_limit": 10
        }
      ],
      "fetch_comments": 5
    },
    "twitter": {
      "enabled": false,
      "users": [
        "karpathy",
        "ylecun"
      ],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "Horizon Brief generation result: #{result}\nImportant items: #{important_items}/#{all_items}"
            },
            {
              "tag": "hr"
            },
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  },
  "personal_briefing": {
    "enabled": false,
    "language": "ru",
    "timezone": "Europe/Paris",
    "daily_empty_allowed": true,
    "min_importance": 7.0,
    "min_importance_priority_topics": 6.5,
    "require_dates": true,
    "source_policy_file": "data/config.personal-news.example.json",
    "priority_topics": [
      "russia",
      "moscow",
      "world_economy",
      "tech_ai",
      "open_source",
      "big_tech",
      "science"
    ],
    "critic_pass": {
      "enabled": true,
      "auto_revise_once": true
    },
    "corroboration": {
      "enabled": true,
      "sensitive_requires_independent_confirmation": true,
      "high_confidence_requires_supporting_source": true,
      "min_independent_confirmations": 1,
      "confirming_roles": ["fact_layer", "context_layer", "science_primary_source", "tech_primary_source"]
    },
    "generate_standard_summaries": false
  },
  "rendering": {
    "template_dir": null,
    "output_formats": ["markdown", "html"],
    "inline_email_css": true
  },
  "publishing": {
    "enabled": true,
    "docs_dir": "docs",
    "site_base_url": null
  },
  "notes": {
    "runtime_config": "data/config.json is local runtime state; do not commit it.",
    "personal_mode": "For evidence-aware personal briefing, disable social/community defaults unless explicitly needed and keep generate_standard_summaries=false."
  }
}
